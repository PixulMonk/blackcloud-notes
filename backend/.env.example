# Database — MongoDB
MONGO_USERNAME=<your_mongo_username>
MONGO_PASSWORD=<your_mongo_password>
MONGO_HOST=<your_mongo_host>
MONGO_DB_NAME=<your_db_name>

# Server
CLIENT_URL=
PORT=3000
NODE_ENV=development

# Auth
# Regenerate fresh on every machine/environment — never copy from another .env
JWT_SECRET=<generate_with_openssl_rand_-hex_32>
SALT_HMAC_SECRET=<generate_with_openssl_rand_-hex_32>

# Email
EMAIL_PROVIDER=maildev
RESEND_API_KEY=<your_resend_api_key>
RESEND_SENDER=<your_resend_sender_email>